# FlimfyBox Environment Variables (Example — never commit real secrets)

# Core Runtime
PORT=3000
APP_DATA_MODE=production
USE_POOLER=true
NODE_DB_POOL_MAX=5

# PostgreSQL / Supabase (shared between Python bot and Node companion backend)
DATABASE_URL=
DATABASE_POOLER_URL=

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=FlimfyBoxBot
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
GROUP_CHAT_ID=
REQUEST_CHANNEL_ID=
ADULT_CHANNEL_ID=
POST_CHANNEL_ID=
ADMIN_CHANNEL_ID=
ADMIN_USER_ID=

# Security & CORS
ALLOWED_ORIGINS=https://flimfybox-bot-yht0.onrender.com
PUBLIC_URL=https://flimfybox-bot-yht0.onrender.com
WEB_APP_URL=https://flimfybox-bot-yht0.onrender.com/webapp
REQUIRE_TELEGRAM_AUTH=false
GUEST_TOKEN_SALT=

# Metadata & AI Providers (server-side only)
TMDB_API_KEY=
OMDB_API_KEY=
TVMAZE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GROQ_API_KEY_1=
GOOGLE_API_KEY=
GOOGLE_CX_ID=
YOUTUBE_API_KEY=
