MINIAPP_TMDB_REVIEW_CACHE_SECONDS=21600
HOME_TRENDING_HERO_LIMIT=10
TMDB_POPULAR_TTL=1800
TMDB_TRENDING_DAY_TTL=1800
TMDB_TRENDING_WEEK_TTL=3600
MAX_REQUESTS_PER_MINUTE=30
REQUEST_COOLDOWN_MINUTES=5
SIMILARITY_THRESHOLD=75
