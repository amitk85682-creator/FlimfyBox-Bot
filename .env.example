OMDB_API_KEY=
TVMAZE_API_KEY=
WATCHMODE_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX_ID=

# Optional AI & integrations (unused in core Node.js preview)
